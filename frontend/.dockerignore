# Node modules (always excluded from Docker context)
node_modules/

# Build output (rebuilt inside Docker)
dist/

# Environment files (never bake secrets into images)
.env
.env.*
.env.local
.env.production.local

# Git history
.git/
.gitignore

# Documentation (not needed in image)
*.md
README*

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
